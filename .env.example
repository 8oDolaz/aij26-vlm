# Copy to .env on the GPU server and adjust. Read by compose.yaml.

# Output of `id -u` / `id -g` on the server, so files created in the container belong to you.
HOST_UID=1000
HOST_GID=1000

# Which GPUs the container sees: all, or e.g. 0 / 0,1
GPUS=all

# Host dir mounted at /data (put LIBERO at <DATA_DIR>/vla, ShareGPT JSONL at <DATA_DIR>/vlm, raw sources wherever)
DATA_DIR=./data

# Host HF cache, mounted at /hf_cache. It must be writable by HOST_UID.
HF_CACHE=~/.cache/huggingface
